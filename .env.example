MUSIC_DATABASE_URL=sqlite:///./music_catalog.db
MUSIC_APP_AUTH_TOKEN=replace-with-a-long-random-app-token
MUSIC_ADMIN_API_KEY=replace-with-a-long-random-admin-key
MUSIC_JWT_SECRET=replace-with-a-long-random-jwt-secret
MUSIC_JWT_EXPIRES_SECONDS=2592000
# PostgreSQL example:
# MUSIC_DATABASE_URL=postgresql+psycopg://music:change-me@127.0.0.1:5432/music
PROVIDER_REQUEST_DELAY_SECONDS=0.4
PROVIDER_TIMEOUT_SECONDS=15
IMPORT_BATCH_LIMIT=5
IMPORT_MAX_TRACKS_PER_ARTIST_HARD_LIMIT=100
MUSIC_FFMPEG_BUILD_CONCURRENCY=1
MUSIC_AUDIO_CACHE_MAX_BYTES=536870912
