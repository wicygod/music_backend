MUSIC_DATABASE_URL=sqlite:///./music_catalog.db
MUSIC_APP_AUTH_TOKEN=replace-with-a-long-random-app-token
MUSIC_ADMIN_API_KEY=replace-with-a-long-random-admin-key
MUSIC_JWT_SECRET=replace-with-a-long-random-jwt-secret
MUSIC_JWT_EXPIRES_SECONDS=2592000
# PostgreSQL example:
# MUSIC_DATABASE_URL=postgresql+psycopg://music:change-me@127.0.0.1:5432/music
PROVIDER_REQUEST_DELAY_SECONDS=0.4
PROVIDER_TIMEOUT_SECONDS=15
IMPORT_BATCH_LIMIT=5
IMPORT_MAX_TRACKS_PER_ARTIST_HARD_LIMIT=100
MUSIC_FFMPEG_BUILD_CONCURRENCY=1
MUSIC_AUDIO_CACHE_MAX_BYTES=536870912

# Personalization and recommendation tuning
MUSIC_ONBOARDING_MIN_ARTISTS=3
MUSIC_ONBOARDING_PAGE_SIZE=24
MUSIC_ONBOARDING_MIN_PROFILE_FOLLOWERS=1000
MUSIC_RECOMMENDATION_LIMIT=48
MUSIC_RECOMMENDATION_CANDIDATES=600
MUSIC_RECOMMENDATION_CACHE_TTL=60
MUSIC_RECOMMENDATION_CACHE_MAX_ENTRIES=2048
MUSIC_PREFERENCE_DECAY_DAYS=90
MUSIC_PREFERENCE_MIN_WEIGHT=-20
MUSIC_PREFERENCE_MAX_WEIGHT=50
MUSIC_SIGNAL_ONBOARDING=5
MUSIC_SIGNAL_COMPLETED=2
MUSIC_SIGNAL_SUBSTANTIAL_PLAY=1.5
MUSIC_SIGNAL_REPEAT=2
MUSIC_SIGNAL_LIKE=4
MUSIC_SIGNAL_PLAYLIST=3
MUSIC_SIGNAL_FOLLOW=5
MUSIC_SIGNAL_ARTIST_VIEW=0.5
MUSIC_SIGNAL_QUICK_SKIP=-1
MUSIC_SIGNAL_REPEATED_QUICK_SKIP=-0.5
MUSIC_FEED_SELECTED_SHARE=0.35
MUSIC_FEED_SIMILAR_SHARE=0.25
MUSIC_FEED_GENRE_SHARE=0.20
MUSIC_FEED_POPULAR_SHARE=0.10
MUSIC_FEED_EXPLORATION_SHARE=0.10

# Public chart ("Popular tracks") tuning
MUSIC_POPULAR_MIN_ARTIST_FOLLOWERS=3000
MUSIC_POPULAR_STRONG_ARTIST_FOLLOWERS=20000
MUSIC_POPULAR_MIN_UNIQUE_LISTENERS=3
MUSIC_POPULAR_REPEAT_CAP_PER_USER=5
MUSIC_POPULAR_PROVIDER_WEIGHT=0.36
MUSIC_POPULAR_ARTIST_WEIGHT=0.32
MUSIC_POPULAR_ENGAGEMENT_WEIGHT=0.26
MUSIC_POPULAR_QUALITY_WEIGHT=0.06
MUSIC_POPULAR_UNKNOWN_PROVIDER_ARTIST_WEIGHT=0.52
MUSIC_POPULAR_UNKNOWN_PROVIDER_ENGAGEMENT_WEIGHT=0.36
MUSIC_POPULAR_UNKNOWN_PROVIDER_QUALITY_WEIGHT=0.12
MUSIC_POPULAR_MIN_PROVIDER_SCORE=45
MUSIC_POPULAR_VARIANT_PENALTY=18
