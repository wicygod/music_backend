[Unit]
Description=Million Dollars Music Backend
After=network.target

[Service]
Type=simple
User=musicbackend
Group=musicbackend
WorkingDirectory=/opt/music_backend
Environment=MUSIC_DATABASE_URL=sqlite:////opt/music_backend/music_catalog.db
ExecStart=/opt/music_backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
